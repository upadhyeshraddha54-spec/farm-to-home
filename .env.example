# Copy this file to `.env.local` and fill in real values (done in Step 2).
# `.env.local` is git-ignored and never committed.
#
# IMPORTANT: every variable starting with VITE_ is bundled into the browser
# code and visible to anyone. Only put PUBLIC identifiers here — never a
# secret key. Firebase web config values are public by design; your data is
# protected by Firestore Security Rules, not by hiding these values.

# Firebase (Firebase console → Project settings → Your apps → Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary (image uploads) — public values only.
# Uploads use an *unsigned upload preset*, so the Cloudinary API SECRET is
# never needed in this app. Never add CLOUDINARY_API_SECRET to this file.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# ---------------------------------------------------------------------------
# Business details shown on the Contact and policy pages (all optional —
# anything left empty is simply not shown). Indian e-commerce rules expect a
# grievance officer and contact details, so fill these in before launch.
VITE_SITE_URL=
VITE_BUSINESS_LEGAL_NAME=
VITE_BUSINESS_ADDRESS=
VITE_SUPPORT_EMAIL=
VITE_SUPPORT_PHONE=
VITE_GRIEVANCE_OFFICER=

# Only if writes ever hang for ~1 minute in production (some networks buffer
# Firestore's streaming connection). See README → Troubleshooting.
# VITE_FIRESTORE_FORCE_LONG_POLLING=true

# Development only: use local emulators instead of the real project.
# VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
# VITE_AUTH_EMULATOR_HOST=127.0.0.1:9099
